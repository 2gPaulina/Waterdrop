{
  "expo": {
    "name": "waterdrop",
    "slug": "waterdrop",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "waterdrop",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "cameraPermission": "WaterDrop necesita la c\u00e1mara para tomar la foto de la fuga.",
          "photosPermission": "WaterDrop necesita tu galer\u00eda para elegir la foto de la fuga."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "WaterDrop usa tu ubicaci\u00f3n para marcar d\u00f3nde est\u00e1 la fuga."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}